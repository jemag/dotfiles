{
  "$schema": "https://opencode.ai/config.json",
  // "model": "github-copilot/claude-opus-4.6",
  // "plugin": [
  //   "/home/jemag/.local/share/opencode-plugins/opencode-model-router"
  // ],
  // Prompt before each websearch call. Queries are model-composed and leave the
  // machine for Exa's hosted MCP service, so they are worth eyeballing.
  // Set to "allow" to stop prompting once comfortable.
  "permission": {
    "websearch": "ask"
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "unsloth/gemma-4-12b-it-GGUF:UD-Q6_K_XL": {
          "name": "unsloth/gemma-4-12b-it-GGUF:UD-Q6_K_XL",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "unsloth/gemma-4-E4B-it-GGUF:Q8_0": {
          "name": "unsloth/gemma-4-E4B-it-GGUF:Q8_0",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "drawio": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "drawio-mcp-server",
        "--editor",
        "--http-port",
        "3030"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "excalidraw": {
      "type": "local",
      "command": [
        "node",
        "/home/jemag/Projects/mcp_excalidraw/dist/index.js"
      ],
      "enabled": false,
      "environment": {
        "EXPRESS_SERVER_URL": "http://localhost:3000",
        "ENABLE_CANVAS_SYNC": "true"
      },
      "timeout": 60000
    },
    "whisker": {
      "type": "local",
      "command": [
        "mcp-whisker-go",
        "server"
      ],
      "environment": {
        "KUBECONFIG": "/home/jemag/.kube/config"
      },
      "enabled": false
    },
    "aks": {
      "type": "local",
      "command": [
        "/usr/local/bin/aks-mcp",
        "--transport",
        "stdio",
        "--access-level",
        "readonly",
        "--enabled-components",
        "az_cli,monitor,fleet,network,compute,detectors,advisor,inspektorgadget,kubectl"
      ],
      "enabled": false
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5.5",
  // "model": "claude-agent/opus",
  // "plugin": [
  //   "/home/jemag/.local/share/opencode-plugins/opencode-model-router"
  // ],
  // Websearch queries are model-composed and leave the machine for Exa's hosted
  // MCP service.
  // These skills are on-demand only (/learn, /deep-research, /adversarial-review
  // commands below). opencode ignores `disable-model-invocation`, so gate here.
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    // Credential files. Only gates the read tool; `cat` via shell is not covered.
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/service.json", "effect": "deny" },
    { "action": "read", "resource": "*.tfstate*", "effect": "ask" },
    { "action": "read", "resource": "*.tfvars", "effect": "ask" },
    // Privilege escalation, work-destroying git commands, system rebuilds.
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "nixos-rebuild *", "effect": "ask" },
    { "action": "shell", "resource": "home-manager switch *", "effect": "ask" },
    // az: ask by default, allow list/show, re-gate credential-bearing commands.
    { "action": "shell", "resource": "az *", "effect": "ask" },
    { "action": "shell", "resource": "az * list *", "effect": "allow" },
    { "action": "shell", "resource": "az * show *", "effect": "allow" },
    { "action": "shell", "resource": "az *keyvault*", "effect": "ask" },
    { "action": "shell", "resource": "az *get-credentials*", "effect": "ask" },
    { "action": "shell", "resource": "az *get-access-token*", "effect": "ask" },
    { "action": "shell", "resource": "az *list-keys*", "effect": "ask" },
    { "action": "shell", "resource": "az *keys list*", "effect": "ask" },
    { "action": "shell", "resource": "az *connection-string*", "effect": "ask" },
    // helm: ask by default, allow read-only; `helm get values` can print secrets.
    { "action": "shell", "resource": "helm *", "effect": "ask" },
    { "action": "shell", "resource": "helm list *", "effect": "allow" },
    { "action": "shell", "resource": "helm status *", "effect": "allow" },
    { "action": "shell", "resource": "helm history *", "effect": "allow" },
    { "action": "shell", "resource": "helm template *", "effect": "allow" },
    { "action": "shell", "resource": "helm lint *", "effect": "allow" },
    { "action": "shell", "resource": "helm show *", "effect": "allow" },
    // kubectl: ask by default, allow read-only verbs, then re-gate anything that
    // can expose secret values. Best effort only; RBAC is the real boundary.
    { "action": "shell", "resource": "kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl events *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl top *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl explain *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl api-resources *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl api-versions *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl version *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl cluster-info", "effect": "allow" },
    { "action": "shell", "resource": "kubectl auth can-i *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl auth whoami *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl rollout status *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl rollout history *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl config current-context *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl config get-contexts *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl *secret*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *Secret*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *--raw*", "effect": "ask" },
    // terraform/terragrunt: ask by default (apply, destroy, state, import...),
    // allow plan only.
    { "action": "shell", "resource": "terraform *", "effect": "ask" },
    { "action": "shell", "resource": "terraform plan *", "effect": "allow" },
    { "action": "shell", "resource": "terraform -chdir=* plan *", "effect": "allow" },
    { "action": "shell", "resource": "terragrunt *", "effect": "ask" },
    { "action": "shell", "resource": "terragrunt plan *", "effect": "allow" },
    { "action": "shell", "resource": "terragrunt run-all plan *", "effect": "allow" },
    { "action": "shell", "resource": "terragrunt run -- plan *", "effect": "allow" },
    { "action": "shell", "resource": "terragrunt run --all -- plan *", "effect": "allow" },
    { "action": "shell", "resource": "terr* *apply*", "effect": "ask" },
    { "action": "shell", "resource": "terr* *destroy*", "effect": "ask" },
    { "action": "skill", "resource": "learn", "effect": "ask" },
    { "action": "skill", "resource": "deep-research", "effect": "ask" },
    { "action": "skill", "resource": "adversarial-review", "effect": "ask" }
  ],
  // Agents are defined here rather than as markdown files in agents/, because
  // `{file:...}` is only interpolated in this `system` field — in a markdown
  // agent the body is taken literally, so `{file:...}` silently yields an
  // empty system prompt. Bodies are shared with Claude Code via ai-agents/.
  // Permission rules are ordered: the last matching rule wins.
  "agents": {
    "teacher": {
      "description": "Explains concepts and reviews code without editing the repo",
      "mode": "primary",
      "system": "{file:/home/jemag/dotfiles/ai-agents/prompts/teacher.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "researcher": {
      "description": "Web researcher — searches the web and synthesizes a sourced brief. Use to verify any fact before teaching it, or to scope a topic before planning a lesson.",
      "mode": "subagent",
      "system": "{file:/home/jemag/dotfiles/ai-agents/agents/researcher.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" }
      ]
    },
    "mermaid-maker": {
      "description": "Authors ONE Mermaid diagram from a brief, renders it to a PNG, LOOKS at the result, iterates until correct and clean, and returns the filename. For structural/relational visuals — dependency graphs, flows, sequences, state machines, trees, ER, timelines.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "system": "{file:/home/jemag/dotfiles/ai-agents/agents/mermaid-maker.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "mkdir *", "effect": "allow" },
        { "action": "shell", "resource": "mmdc *", "effect": "allow" },
        { "action": "shell", "resource": "sed *", "effect": "allow" },
        { "action": "shell", "resource": "rsvg-convert *", "effect": "allow" },
        { "action": "shell", "resource": "mv *", "effect": "allow" },
        { "action": "shell", "resource": "rm viz/*", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "date*", "effect": "allow" }
      ]
    },
    "svg-maker": {
      "description": "Authors ONE hand-written SVG from a brief, renders it to a PNG, LOOKS at the result, iterates until correct and clean, and returns the filename. For spatial/geometric visuals Mermaid can't express — coordinate geometry, number lines, vectors, function plots, physical layouts.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "system": "{file:/home/jemag/dotfiles/ai-agents/agents/svg-maker.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "mkdir *", "effect": "allow" },
        { "action": "shell", "resource": "rsvg-convert *", "effect": "allow" },
        { "action": "shell", "resource": "magick *", "effect": "allow" },
        { "action": "shell", "resource": "mv *", "effect": "allow" },
        { "action": "shell", "resource": "rm viz/*", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "date*", "effect": "allow" }
      ]
    }
  },
  // On-demand entry points for skills gated to "ask" above. Approving the
  // permission prompt is the one confirmation step.
  "commands": {
    "learn": {
      "description": "Teach a topic with the learn skill",
      "template": "Load the `learn` skill and use it to teach me: $ARGUMENTS"
    },
    "deep-research": {
      "description": "Cited deep-research report",
      "template": "Load the `deep-research` skill and research: $ARGUMENTS"
    },
    "adversarial-review": {
      "description": "Adversarial regression analysis of a change",
      "template": "Load the `adversarial-review` skill and run it on: $ARGUMENTS (default: working tree)"
    }
  },
  "providers": {
    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:9931/v1"
      },
      "models": {
        "local-llama-server": {
          "name": "local-llama-server",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "drawio": {
        "type": "local",
        "command": [
          "drawio-mcp-server",
          "--editor",
          "--http-port",
          "3030"
        ],
        "disabled": true,
        "timeout": { "catalog": 60000, "execution": 60000 }
      },
      "excalidraw": {
        "type": "local",
        "command": [
          "node",
          "/home/jemag/Projects/mcp_excalidraw/dist/index.js"
        ],
        "disabled": true,
        "environment": {
          "EXPRESS_SERVER_URL": "http://localhost:3000",
          "ENABLE_CANVAS_SYNC": "true"
        },
        "timeout": { "catalog": 60000, "execution": 60000 }
      },
      "whisker": {
        "type": "local",
        "command": [
          "mcp-whisker-go",
          "server"
        ],
        "environment": {
          "KUBECONFIG": "/home/jemag/.kube/config"
        },
        "disabled": true
      },
      "aks": {
        "type": "local",
        "command": [
          "/usr/local/bin/aks-mcp",
          "--transport",
          "stdio",
          "--access-level",
          "readonly",
          "--enabled-components",
          "az_cli,monitor,fleet,network,compute,detectors,advisor,inspektorgadget,kubectl"
        ],
        "disabled": true
      }
    }
  }
}
